# =============================================================================
# OpenClaw – Dokploy Environment Variables
# =============================================================================
# Copy this to your Dokploy Environment Variables tab.
# Only uncomment and fill the values you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway Auth (REQUIRED for remote/LAN access)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Leave empty for auto-generation on first start.
OPENCLAW_GATEWAY_TOKEN=

# Timezone
OPENCLAW_TZ=UTC

# Port mappings (defaults are fine for Dokploy)
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790

# -----------------------------------------------------------------------------
# Model Provider API Keys (set at LEAST one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# Channel Tokens (optional – only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# -----------------------------------------------------------------------------
# Advanced (optional)
# -----------------------------------------------------------------------------
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
