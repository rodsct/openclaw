# =============================================================================
# OpenClaw – Dokploy Environment Variables
# =============================================================================
# Copy this to your Dokploy Environment Variables tab.
# Only uncomment and fill the values you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway Security (REQUIRED for production)
# -----------------------------------------------------------------------------
# 1. Gateway Token: Generate a secure password using: openssl rand -hex 32
# This will be your master password to access the OpenClaw Control UI.
OPENCLAW_GATEWAY_TOKEN=

# 2. Allowed Origins: Prevent unauthorized frontends from connecting to your node.
# Must be an exact array containing your real HTTPS domain in Dokploy.
# Example: '["https://claw.aranza.io"]'
# Important: Use single quotes outside, double quotes inside the JSON format!
OPENCLAW_GATEWAY_CONTROL_UI_ALLOWED_ORIGINS=

# Timezone
OPENCLAW_TZ=UTC

# Port mappings (defaults are fine for Dokploy)
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790

# -----------------------------------------------------------------------------
# Model Provider API Keys (set at LEAST one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# Channel Tokens (optional – only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# -----------------------------------------------------------------------------
# Advanced (optional)
# -----------------------------------------------------------------------------
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
